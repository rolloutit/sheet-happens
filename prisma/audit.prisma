model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorMemberId String?  @map("actor_member_id") @db.Uuid
  action        String
  targetType    String   @map("target_type")
  targetId      String   @map("target_id")
  before        Json?
  after         Json?
  requestId     String?  @map("request_id")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  /// "WEB" for a browser action, "MCP" for an AI agent, "API" for a personal access token.
  channel       String?
  /// MCP: the OAuth client id (CIMD URL or registered id). API: `api_token:<api_tokens.id>`.
  clientId      String?  @map("client_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor Member? @relation("AuditActor", fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([actorMemberId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
