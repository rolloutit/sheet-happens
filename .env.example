# Copy to `.env.local` for local development. In production, set these as real environment
# variables (see docs/self-hosting.md). Every value below is a fake placeholder.

# ── Core ─────────────────────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Migrations and the app both read it.
DATABASE_URL="postgresql://sheet_happens:sheet_happens@localhost:5432/sheet_happens?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────────────────────────
# Generate with `openssl rand -base64 32`. Left empty, local dev falls back to a built-in dev-only
# secret; production refuses to start without it. Never reuse a value across deployments.
BETTER_AUTH_SECRET=""
# Optional separate HMAC secret for password-login attempt identifiers. Defaults to BETTER_AUTH_SECRET.
AUTH_LOGIN_ATTEMPT_SECRET=""
# The public origin of the app, with scheme and no trailing slash. In production this must be the
# exact HTTPS origin users open: it is the passkey RP ID host, the OAuth issuer and the base of every
# e-mailed link. The three URLs below should all hold the same value. The NEXT_PUBLIC_* ones are baked
# into the client bundle at build time, so changing them means rebuilding the image.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
# Optional branding: show your organisation instead of plain "Sheet Happens". NEXT_PUBLIC_ORG_* are
# baked into the client bundle at build time (rebuild to change them). Logos are a /public path or an
# absolute URL; the dark one falls back to the light one. ORG_LOGO_PDF_PATH is read at runtime.
# See docs/self-hosting.md, section "Branding".
# NEXT_PUBLIC_ORG_NAME=""
# NEXT_PUBLIC_ORG_LOGO=""
# NEXT_PUBLIC_ORG_LOGO_DARK=""
# ORG_LOGO_PDF_PATH=""
# Optional comma-separated list of additional origins Better Auth should trust (for example a second
# hostname that serves the same app). Leave empty unless you know you need it.
# AUTH_TRUSTED_ORIGINS=""
# Uncomment to skip the 2FA/passkey security-setup gate (incl. the admin TOTP requirement) in local
# dev. Ignored outside NODE_ENV!=="production", so it has no effect in any deployed environment.
# AUTH_SECURITY_SETUP_MODE="optional"

# ── E-mail ───────────────────────────────────────────────────────────────────────────────────────
# `console` (default) prints magic links and invitations to the server log, fine for local dev.
# `smtp` sends real mail and is required in production. `file` appends to an outbox file and is
# refused when NODE_ENV=production (dev/e2e only).
AUTH_EMAIL_DELIVERY_MODE="console"
# The From header of every outgoing message.
AUTH_EMAIL_FROM="Sheet Happens <auth@sheethappens.local>"
# Dev/e2e only: outbox path for AUTH_EMAIL_DELIVERY_MODE=file (default `.mail/outbox.jsonl`).
# AUTH_EMAIL_FILE=".mail/outbox.jsonl"
# SMTP settings, used when AUTH_EMAIL_DELIVERY_MODE=smtp. SMTP_SECURE="true" means implicit TLS
# (usually port 465); leave it "false" for STARTTLS on port 587.
SMTP_HOST="mail.example.com"
SMTP_PORT="587"
SMTP_USER="sheet-happens@example.com"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_SECURE="false"

# ── Google sign-in (optional) ────────────────────────────────────────────────────────────────────
# Enabled only when all three are set. Restricted to the listed Google Workspace domains
# (comma-separated); redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""
AUTH_GOOGLE_ALLOWED_DOMAINS="example.com"

# ── First admin bootstrap ────────────────────────────────────────────────────────────────────────
# `pnpm railway:bootstrap-admin` (the same script runs outside Railway) creates the first admin
# invitation. It does nothing while BOOTSTRAP_ADMIN_EMAIL is empty, and it is safe to re-run.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_FIRST_NAME="QA"
BOOTSTRAP_ADMIN_LAST_NAME="Admin"
# ISO 4217 code, IANA time zone and UI locale (`en` or `hu`) of the first admin.
BOOTSTRAP_ADMIN_CURRENCY="EUR"
BOOTSTRAP_ADMIN_TIMEZONE="Europe/Budapest"
BOOTSTRAP_ADMIN_LOCALE="en"
# "true" also e-mails the invitation (needs AUTH_EMAIL_DELIVERY_MODE=smtp); the accept URL is
# always printed to the script's output.
BOOTSTRAP_ADMIN_SEND_EMAIL="false"

# ── Object storage ───────────────────────────────────────────────────────────────────────────────
# Any S3-compatible store (MinIO, AWS S3, Cloudflare R2, …). Holds contractor invoices, payslips and avatars.
# S3_ENDPOINT must also be reachable from the users' browsers: documents are served through
# short-lived signed URLs the app redirects to. The bucket must already exist.
OBJECT_STORAGE_PROVIDER="s3"
S3_ENDPOINT="http://localhost:9000"
# Default `auto` (what R2 expects); AWS S3 needs the bucket's real region.
S3_REGION="us-east-1"
S3_BUCKET="sheet-happens-dev"
S3_ACCESS_KEY_ID="sheet_happens"
S3_SECRET_ACCESS_KEY="sheet_happens"
# "true" for MinIO and most self-hosted stores (bucket in the path, not the hostname).
S3_FORCE_PATH_STYLE="true"

# ── PDF export ───────────────────────────────────────────────────────────────────────────────────
# Path of the Typst binary (0.15.1). The Docker image already ships it at /usr/local/bin/typst.
TYPST_BIN="typst"
# Optional overrides. Both default to src/server/pdf/{templates,fonts} relative to the
# working directory, which is correct in dev and in the standalone production build.
# TYPST_TEMPLATES_DIR=""
# TYPST_FONTS_DIR=""

# ── Integrations and background jobs ─────────────────────────────────────────────────────────────
# MCP Dynamic Client Registration. Defaults to on outside production and off in production;
# set "true" or "false" to force it. Leave unset unless you are testing with the MCP Inspector.
# MCP_ALLOW_DYNAMIC_CLIENT_REGISTRATION="false"
# "true" turns off the in-process notification scheduler (it polls every 15 seconds) in this
# instance. Several instances are safe without it: the dispatcher takes a Postgres advisory lock.
# NOTIFICATION_SCHEDULER_DISABLED="false"

# ── Test-only (not read by the running app) ──────────────────────────────────────────────────────
# E2E_PORT=3000                 port the Playwright suite starts or reuses its server on
# RUN_TYPST_SMOKE=1             `pnpm test:pdf` sets this to render the PDF templates for real
# REPORT_PDF_SMOKE_DIR=""       directory the PDF smoke tests write their output to
# UPDATE_MCP_CONTRACT=1         refresh the MCP contract snapshot test
