DATABASE_URL="postgresql://sheet_happens:sheet_happens@localhost:5432/sheet_happens?schema=public"
# Generate with `openssl rand -base64 32`. Left empty, local dev falls back to a built-in dev-only
# secret; production refuses to start without it. Never reuse a value across deployments.
BETTER_AUTH_SECRET=""
# Optional separate HMAC secret for password-login attempt identifiers. Defaults to BETTER_AUTH_SECRET.
AUTH_LOGIN_ATTEMPT_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
AUTH_EMAIL_DELIVERY_MODE="console"
# Uncomment to skip the 2FA/passkey security-setup gate (incl. the admin TOTP requirement) in local
# dev. Ignored outside NODE_ENV!=="production", so it has no effect in any deployed environment.
# AUTH_SECURITY_SETUP_MODE="optional"
AUTH_EMAIL_FROM="Sheet Happens <auth@sheethappens.local>"
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""
AUTH_GOOGLE_ALLOWED_DOMAINS="example.com"
SMTP_HOST="mail.example.com"
SMTP_PORT="587"
SMTP_USER="sheet-happens@example.com"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_SECURE="false"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_FIRST_NAME="QA"
BOOTSTRAP_ADMIN_LAST_NAME="Admin"
BOOTSTRAP_ADMIN_CURRENCY="EUR"
BOOTSTRAP_ADMIN_TIMEZONE="Europe/Budapest"
BOOTSTRAP_ADMIN_LOCALE="en"
BOOTSTRAP_ADMIN_SEND_EMAIL="false"
OBJECT_STORAGE_PROVIDER="s3"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="sheet-happens-dev"
S3_ACCESS_KEY_ID="sheet_happens"
S3_SECRET_ACCESS_KEY="sheet_happens"
S3_FORCE_PATH_STYLE="true"
TYPST_BIN="typst"
# Optional overrides. Both default to src/server/pdf/{templates,fonts} relative to the
# working directory, which is correct in dev and in the standalone production build.
# TYPST_TEMPLATES_DIR=""
# TYPST_FONTS_DIR=""
