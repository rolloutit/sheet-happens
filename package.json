{
  "name": "sheet-happens",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.5.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --config vitest.storybook.config.ts",
    "chromatic": "chromatic --exit-zero-on-changes",
    "test:visual": "pnpm build-storybook && playwright test --config playwright.visual.config.ts",
    "test:visual:static": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "pnpm build-storybook && playwright test --config playwright.visual.config.ts --update-snapshots",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "ci": "pnpm typecheck && pnpm lint && pnpm format && pnpm test && pnpm build-storybook && pnpm test-storybook && pnpm test:visual:static && pnpm e2e"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.23",
    "@hookform/resolvers": "latest",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-table": "latest",
    "better-auth": "^1.6.23",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "dotenv": "^17.4.2",
    "lucide-react": "latest",
    "next": "latest",
    "next-intl": "latest",
    "next-themes": "latest",
    "pg": "^8.22.0",
    "radix-ui": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "recharts": "latest",
    "sonner": "latest",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@playwright/test": "latest",
    "@storybook/addon-a11y": "latest",
    "@storybook/addon-docs": "latest",
    "@storybook/addon-vitest": "latest",
    "@storybook/nextjs-vite": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/dom": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitest/browser-playwright": "latest",
    "chromatic": "latest",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "eslint-plugin-storybook": "latest",
    "jsdom": "latest",
    "msw": "latest",
    "playwright": "latest",
    "prettier": "latest",
    "prisma": "^7.8.0",
    "storybook": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
