{
  "name": "sheet-happens",
  "version": "0.1.0",
  "private": true,
  "description": "Time tracking, monthly timesheet approval and contractor invoice verification for companies that bill by the hour.",
  "keywords": [
    "time-tracking",
    "timesheet",
    "invoicing",
    "self-hosted",
    "nextjs",
    "prisma",
    "mcp"
  ],
  "license": "AGPL-3.0-only",
  "homepage": "https://sheethappens.rolloutit.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolloutit/sheet-happens.git"
  },
  "bugs": {
    "url": "https://github.com/rolloutit/sheet-happens/issues"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.5.0"
  },
  "scripts": {
    "dev:e2e": "AUTH_EMAIL_DELIVERY_MODE=file AUTH_EMAIL_FILE=.mail/e2e-outbox.jsonl AUTH_SECURITY_SETUP_MODE=optional DATABASE_URL=\"$(node scripts/dev-db.mjs test-url)\" pnpm dev",
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "start:next": "next start",
    "postinstall": "prisma generate",
    "setup:git": "node scripts/setup-git.mjs",
    "db:format": "prisma format",
    "db:dev": "node scripts/dev-db.mjs",
    "db:dev:reset": "node scripts/dev-db.mjs reset",
    "db:dev:seed": "node scripts/dev-db.mjs seed",
    "db:dev:stop": "node scripts/dev-db.mjs stop",
    "db:test": "node scripts/dev-db.mjs test",
    "db:test:reset": "node scripts/dev-db.mjs test-reset",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "railway:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:pdf": "RUN_TYPST_SMOKE=1 vitest run --config vitest.config.ts src/server/pdf src/server/reports",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --config vitest.storybook.config.ts",
    "chromatic": "chromatic --exit-zero-on-changes",
    "test:visual": "pnpm build-storybook && playwright test --config playwright.visual.config.ts",
    "test:visual:static": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "pnpm build-storybook && playwright test --config playwright.visual.config.ts --update-snapshots",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:a11y": "playwright test --grep @a11y",
    "e2e:failed": "playwright test --last-failed",
    "verify:fast": "pnpm typecheck && pnpm lint && pnpm test",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm test && pnpm build-storybook && pnpm test-storybook && pnpm test:visual:static && pnpm e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@better-auth/cimd": "^1.7.3",
    "@better-auth/mcp": "^1.7.3",
    "@better-auth/passkey": "^1.7.3",
    "@better-auth/prisma-adapter": "^1.7.3",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.40.0",
    "motion": "^13.2.0",
    "next": "16.3.3",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/storybook": "^5.3.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "chromatic": "^18.7.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-storybook": "^10.6.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  }
}
